# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Playwright 스크린샷 테스트용 (선택)
E2E_TEST_EMAIL=test@gigang.dev
E2E_TEST_PASSWORD=your-test-password

# 클라이언트 개발 전용 UI(이메일 로그인 등). 개발계(Vercel gigang-client-dev)에서만 true 권장.
# 운영 프로젝트에는 설정하지 마세요. 로컬 `pnpm dev`는 NODE_ENV=development 로 자동 허용되어 생략 가능.
# NEXT_PUBLIC_ENABLE_DEV_MODE=true

# Gemini API 키 (Google AI Studio) — 기록증 OCR 추출용 (서버 전용)
GEMINI_API_KEY=

# 뉴비 온보딩 미참석 넛지 크론(/api/cron/newbie-nudge) 인증용 시크릿 (서버 전용)
# Vercel Cron이 호출 시 Authorization: Bearer <CRON_SECRET> 헤더를 자동 첨부한다.
CRON_SECRET=

# ── 점검 모드 ─────────────────────────────────────────────────────────
# 켜고 끄는 스위치는 여기 없다 — Vercel Global Config(옛 Edge Config)에 있다.
# 환경변수는 바꿀 때마다 재배포가 필요해서 "장애 났을 때 즉시 켠다"에 못 쓴다.
#   Global Config 키:  maintenance (boolean) / maintenanceUntil (선택, 'YYYY-MM-DD HH:mm' KST)
#
# 점검 중 운영자만 원래 앱을 보는 우회 열쇠. ?bypass=<값> 으로 한 번 들어오면 쿠키가 남는다.
# 미설정이면 우회가 통째로 닫힌다.
MAINTENANCE_BYPASS_SECRET=
# 아래 둘은 Global Config 없이 로컬에서 점검 화면만 확인할 때 쓰는 우회로다.
# MAINTENANCE_MODE=1
# MAINTENANCE_UNTIL=2026-09-23 22:00
